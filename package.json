{
  "name": "openclaw-command-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:redaction": "node --experimental-strip-types scripts/verifyRedaction.ts",
    "test:adapter-selection": "node --experimental-strip-types scripts/verifyAdapterSelection.ts",
    "test:adapter-diagnostics": "node --experimental-strip-types scripts/verifyAdapterDiagnostics.ts",
    "test:snapshot-state": "node --experimental-strip-types scripts/verifySnapshotState.ts",
    "test:keyboard-accessibility": "node --experimental-strip-types scripts/verifyKeyboardAccessibility.ts",
    "test:responsive-accessibility": "node --experimental-strip-types scripts/verifyResponsiveAccessibility.ts",
    "test:content-density": "node --experimental-strip-types scripts/verifyContentDensity.ts",
    "test:state-copy": "node --experimental-strip-types scripts/verifyStateCopy.ts",
    "test:visual-polish": "node --experimental-strip-types scripts/verifyVisualPolish.ts",
    "test:composition-qa": "node --experimental-strip-types scripts/verifyCompositionQa.ts",
    "test:office-scene": "node --experimental-strip-types scripts/verifyOfficeScene.ts",
    "test:all": "npm run test:redaction && npm run test:adapter-selection && npm run test:adapter-diagnostics && npm run test:snapshot-state && npm run test:keyboard-accessibility && npm run test:responsive-accessibility && npm run test:content-density && npm run test:state-copy && npm run test:visual-polish && npm run test:composition-qa && npm run test:office-scene",
    "smoke:html": "node --experimental-strip-types scripts/smokeHtml.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
